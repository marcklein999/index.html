<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Surveillance Dashboard</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f4f7f6; margin: 0; padding: 15px; color: #333; }
        .container { max-width: 600px; margin: 0 auto; background: #fff; padding: 20px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
        h2 { color: #2c3e50; text-align: center; margin-bottom: 5px; }
        .subtitle { text-align: center; color: #7f8c8d; font-size: 0.9em; margin-bottom: 20px; }
        .date-picker { text-align: center; margin-bottom: 20px; }
        .date-picker input { padding: 8px 12px; font-size: 1em; border: 1px solid #ccc; border-radius: 6px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        th { background-color: #2c3e50; color: white; font-size: 0.95em; }
        tr:hover { background-color: #f9f9f9; }
        .info-box { background: #e8f4fd; padding: 10px 15px; border-radius: 6px; margin-bottom: 15px; font-weight: bold; color: #2980b9; text-align: center; }
    </style>
</head>
<body>

<div class="container">
    <h2>Surveillance Dashboard</h2>
    <div class="subtitle">Planning dynamique des surveillants</div>

    <div class="date-picker">
        <label for="currentDate">Date : </label>
        <input type="date" id="currentDate" onchange="updateDashboard()">
    </div>

    <div class="info-box" id="cycleInfo">Cycle : - | Jour : -</div>

    <table>
        <thead>
            <tr>
                <th>Position</th>
                <th>Surveillant(e) / Aufseher(in)</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            <!-- Rempli dynamiquement par JavaScript -->
        </tbody>
    </table>
</div>

<script>
    const cycleDatabase = [
        ["PETRA", "BARBARA", "SHIRIN", "MARC", "ANNIE", "SOMAYA"],
        ["SOMAYA", "PETRA", "BARBARA", "SHIRIN", "MARC", "ANNIE"],
        ["ANNIE", "SOMAYA", "PETRA", "BARBARA", "SHIRIN", "MARC"],
        ["MARC", "ANNIE", "SOMAYA", "PETRA", "BARBARA", "SHIRIN"],
        ["SHIRIN", "MARC", "ANNIE", "SOMAYA", "PETRA", "BARBARA"],
        ["BARBARA", "SHIRIN", "MARC", "ANNIE", "SOMAYA", "PETRA"]
    ];

    const positions = [
        "Pos 1 (Marronnier/Kastanie)",
        "Pos 2 (Hêtre/Buche)",
        "Pos 3 (Montée/Aufgang)",
        "Pos 4 (Anciens bacs/Hochbeet)",
        "Pos 5 (Bac à sable/Sandkasten)",
        "Pos 6 (WC Bellmerin)"
    ];

    const refDate = new Date('2026-10-12');

    document.getElementById('currentDate').valueAsDate = new Date();
    updateDashboard();

    function updateDashboard() {
        const selectedDateInput = document.getElementById('currentDate').value;
        if (!selectedDateInput) return;

        const selectedDate = new Date(selectedDateInput);
        const dayOfWeek = selectedDate.getDay();

        const tableBody = document.getElementById('tableBody');
        const cycleInfo = document.getElementById('cycleInfo');
        tableBody.innerHTML = '';

        if (dayOfWeek === 0 || dayOfWeek === 6) {
            cycleInfo.innerText = "Pas de surveillance / keine Aufsicht (Week-end)";
            positions.forEach(pos => {
                tableBody.innerHTML += `<tr><td>${pos}</td><td><em>Pas de surveillance</em></td></tr>`;
            });
            return;
        }

        const diffTime = selectedDate - refDate;
        const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
        let cycleIndex = (diffDays % 6 + 6) % 6; 
        let currentAssigned = cycleDatabase[cycleIndex];

        cycleInfo.innerText = `Cycle ${cycleIndex + 1} - Jour d'école`;

        for (let i = 0; i < positions.length; i++) {
            tableBody.innerHTML += `<tr><td>${positions[i]}</td><td><strong>${currentAssigned[i]}</strong></td></tr>`;
        }
    }
</script>

</body>
</html>
